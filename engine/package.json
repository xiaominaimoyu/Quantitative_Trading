{
  "name": "@quant-trading/engine",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript backtesting core: cost model, risk layer, data quality pipeline, reproducible experiments",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "~6.0.2",
    "vitest": "^3.2.4"
  }
}
